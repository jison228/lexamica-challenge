# --- API configuration ---
NODE_ENV=development
PORT=4000

# MongoDB connection (matches the root docker-compose service).
# directConnection=true targets the single-node replica set so transactions work.
MONGODB_URI=mongodb://localhost:27017/lexamica?directConnection=true

# Auth / session
JWT_SECRET=dev-only-change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=lexamica_session

# CORS origin allowed to send credentials (the web app)
WEB_ORIGIN=http://localhost:3000
